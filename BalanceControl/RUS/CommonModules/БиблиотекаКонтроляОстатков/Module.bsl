// Параметры:
//  ОбъектДокумента - ДокументОбъект - Документ, у которого очищаются ключи контроля.
Процедура ОчиститьДополнительныеСвойства(ОбъектДокумента)

	ОбъектДокумента.ДополнительныеСвойства.Удалить(ИмяДеталейРежимаЗаписи());
	ОбъектДокумента.ДополнительныеСвойства.Удалить(ИмяДанныхРегистров());
	ОбъектДокумента.ДополнительныеСвойства.Удалить(ИмяСтаройДаты());


#Область Зависимости

// Область самодостаточна: вызовы БСП оставлены комментариями, чтобы база с БСП
// могла вернуться на библиотечные реализации, раскомментировав их.

// Читает значение одного реквизита объекта из базы по ссылке.
// Возвращает Неопределено, если строка по ссылке не найдена.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - Объект, чей реквизит читается.
//  ИмяРеквизита - Строка - Имя реквизита.
//
// Возвращаемое значение:
//  Произвольный - Значение реквизита или Неопределено.
Функция _ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита)
	// БСП: Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита);

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ИсходнаяТаблица.ИмяРеквизита КАК ЗначениеРеквизита
	|ИЗ
	|	ИмяТаблицы КАК ИсходнаяТаблица
	|ГДЕ
	|	ИсходнаяТаблица.Ссылка = &Ссылка";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяРеквизита", ИмяРеквизита);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяТаблицы", "Документ." + Ссылка.Метаданные().Имя);

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗначениеРеквизита;
	КонецЕсли;

	Возврат Неопределено;
КонецФункции

// Дополняет массив-приемник значениями из массива-источника.
//
// Параметры:
//  МассивПриемник - Массив из Произвольный - Массив-приемник.
//  МассивИсточник - Массив из Произвольный - Массив-источник.
Процедура _ДополнитьМассив(МассивПриемник, МассивИсточник)
	// БСП: ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивПриемник, МассивИсточник);

	Для Каждого ЗначениеИсточника Из МассивИсточник Цикл
		МассивПриемник.Добавить(ЗначениеИсточника);
	КонецЦикла;
КонецПроцедуры

// Создает массив со значениями одной колонки коллекции.
//
// Параметры:
//  ИсходнаяТаблица - ТаблицаЗначений - Коллекция, чья колонка выгружается.
//  ИмяКолонки - Строка - Имя колонки.
//  ТолькоУникальныеЗначения - Булево - Истина - добавляются только уникальные значения.
//
// Возвращаемое значение:
//  Массив из Произвольный - Значения колонки.
Функция _ВыгрузитьКолонку(ИсходнаяТаблица, ИмяКолонки, ТолькоУникальныеЗначения)
	// БСП: Возврат ОбщегоНазначения.ВыгрузитьКолонку(ИсходнаяТаблица, ИмяКолонки, ТолькоУникальныеЗначения);

	МассивЗначений = Новый Массив;
	УникальныеЗначения = Новый Соответствие;

	Для Каждого СтрокаКоллекции Из ИсходнаяТаблица Цикл
		ЗначениеКолонки = СтрокаКоллекции[ИмяКолонки];
		Если ТолькоУникальныеЗначения И УникальныеЗначения[ЗначениеКолонки] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивЗначений.Добавить(ЗначениеКолонки);
		УникальныеЗначения.Вставить(ЗначениеКолонки, Истина);
	КонецЦикла;

	Возврат МассивЗначений;
КонецФункции

// Подставляет значения параметров вместо их имен в строке-шаблоне.
// Параметры в строке заключены в квадратные скобки.
//
// Параметры:
//  Шаблон - Строка - Строка-шаблон для подстановки.
//  Параметры - Структура - Значения для подстановки: ключ - имя параметра, значение - подставляемое.
//
// Возвращаемое значение:
//  Строка - Строка с подставленными значениями.
Функция _ВставитьПараметрыВСтроку(Шаблон, Параметры)
	// БСП: Возврат СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, Параметры);

	Результат = Шаблон;
	Для Каждого Параметр Из Параметры Цикл
		Результат = СтрЗаменить(Результат, "[" + Параметр.Ключ + "]", Параметр.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецОбласти

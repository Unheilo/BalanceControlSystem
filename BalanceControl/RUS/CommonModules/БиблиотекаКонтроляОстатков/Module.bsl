#Область СлужебныйПрограммныйИнтерфейс

#Область Подписки

// Подписка. ПередЗаписью.
//
// Параметры:
//  ОбъектДокумента - ДокументОбъект - Записываемый документ.
//  Отказ - Булево - Признак отказа от записи (системой контроля не используется).
//  РежимЗаписи - РежимЗаписиДокумента - Режим записи.
//  РежимПроведения - РежимПроведенияДокумента - Режим проведения.
Процедура КонтрольОстатков_Документы_ПередЗаписью(ОбъектДокумента, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ОчиститьДополнительныеСвойства(ОбъектДокумента);

	Если ОбъектДокумента.ОбменДанными.Загрузка Или СистемаВыключена() Или РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Возврат;
	КонецЕсли;

	ВыполнятьКонтроль = Истина;
	БиблиотекаКонтроляОстатковПереопределяемый.ПриОпределенииНеобходимостиКонтроля(ОбъектДокумента, ВыполнятьКонтроль);
	Если Не ВыполнятьКонтроль Тогда
		Возврат;
	КонецЕсли;

	ДобавитьСтарыеДвиженияИМетаданныеРегистров(ОбъектДокумента);
	СтараяДата = ?(ОбъектДокумента.ЭтоНовый(), ОбъектДокумента.Дата, _ЗначениеРеквизитаОбъекта(ОбъектДокумента.Ссылка, "Date"));
	ОбъектДокумента.ДополнительныеСвойства.Вставить(ИмяСтаройДаты(), СтараяДата);
	ОбъектДокумента.ДополнительныеСвойства.Вставить(ИмяДеталейРежимаЗаписи(), ДеталиРежимаЗаписи(ОбъектДокумента, РежимЗаписи));

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Подписка. ПриЗаписи.
//
// Параметры:
//  ОбъектДокумента - ДокументОбъект - Записываемый документ.
//  Отказ - Булево - Признак отказа от записи (системой контроля не используется).
Процедура КонтрольОстатков_Документы_ПриЗаписи(ОбъектДокумента, Отказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ОбъектДокумента.ОбменДанными.Загрузка Или СистемаВыключена() Тогда
		Возврат;
	КонецЕсли;

	ДанныеДеталейРежимаЗаписи = Неопределено;
	Если Не ОбъектДокумента.ДополнительныеСвойства.Свойство(ИмяДеталейРежимаЗаписи(), ДанныеДеталейРежимаЗаписи) Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеДеталейРежимаЗаписи.ЭтоОтменаПроведения Тогда

		ЗаписатьКонтролируемыеНаборыДвижений(ОбъектДокумента);
		ВыполнитьКонтрольОстатков(ОбъектДокумента);

	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Подписка. ПередПроведением. (После)
//
// Параметры:
//  ОбъектДокумента - ДокументОбъект - Проводимый документ.
//  Отказ - Булево - Признак отказа от проведения (системой контроля не используется).
//  РежимПроведения - РежимПроведенияДокумента - Режим проведения.
Процедура КонтрольОстатков_Документы_ОбработкаПроведения(ОбъектДокумента, Отказ, РежимПроведения) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ОбъектДокумента.ОбменДанными.Загрузка Или СистемаВыключена() Тогда
		Возврат;
	КонецЕсли;

	Если Не ОбъектДокумента.ДополнительныеСвойства.Свойство(ИмяДанныхРегистров()) Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьКонтролируемыеНаборыДвижений(ОбъектДокумента);
	ВыполнитьКонтрольОстатков(ОбъектДокумента);

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВыключательСистемы

// Проверяет, что система контроля остатков выключена.
//
// Возвращаемое значение:
//  Булево - Истина, если система выключена, иначе Ложь.
Функция СистемаВыключена()

	Возврат Константы.ОтключитьСистемуКонтроляОстатков.Получить();

КонецФункции

#КонецОбласти

#Область Инициализация

// Заполняет дополнительные свойства объекта данными из регистров накопления,
// находящихся под контролем, включая их измерения, ресурсы и старые движения.
//
// Параметры:
//  Объект - ДокументОбъект - Обрабатываемый документ; его дополнительные свойства заполняются данными контроля.
//
//@skip-check query-in-loop
Процедура ДобавитьСтарыеДвиженияИМетаданныеРегистров(Объект)

	ДанныеРегистров = Новый Массив;
	ТипыРегистровПодКонтролем = Метаданные.ОпределяемыеТипы.РегистрыПодКонтролем.Тип;

	Для Каждого Регистр Из Объект.Движения Цикл

		Если Не ТипыРегистровПодКонтролем.СодержитТип(ТипЗнч(Регистр)) Тогда
			Продолжить;
		КонецЕсли;

		МетаданныеРегистра = Регистр.Метаданные();
		ПроверитьВозможностьКонтроляРегистра(МетаданныеРегистра);

		Данные = Новый Структура;

		Измерения = Новый Массив;
		Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
			Измерения.Добавить(Измерение.Имя);
		КонецЦикла;

		Ресурсы = Новый Массив;
		Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
			Ресурсы.Добавить(Ресурс.Имя);
		КонецЦикла;

		БиблиотекаКонтроляОстатковПереопределяемый.ПриОпределенииКонтролируемыхРесурсов(Объект, МетаданныеРегистра, Ресурсы);
		ПроверитьКонтролируемыеРесурсы(МетаданныеРегистра, Ресурсы);

		Данные.Вставить("Измерения", Измерения);
		Данные.Вставить("Ресурсы", Ресурсы);
		Данные.Вставить("Имя", МетаданныеРегистра.Имя);
		// Русское имя таблицы для запросов: ПолноеИмя() в англоязычной конфигурации вернуло бы
		// AccumulationRegister.X, а смешивать язык корня и виртуальной таблицы запросу нельзя.
		Данные.Вставить("ПолноеИмя", "РегистрНакопления." + МетаданныеРегистра.Имя);

		УпорядочитьМетаданныеПоКластерномуИндексу(Данные);

		СтарыеДвижения_Расход = ДвиженияДокумента(Объект.Ссылка, Данные, ВидДвиженияНакопления.Расход);
		СтарыеДвижения_Приход = ДвиженияДокумента(Объект.Ссылка, Данные, ВидДвиженияНакопления.Приход);
		ОбработатьСторноВДвухТаблицах(СтарыеДвижения_Расход, СтарыеДвижения_Приход, Ресурсы);

		Данные.Вставить(ИмяСтарыхДвиженийРасхода(), СтарыеДвижения_Расход);
		Данные.Вставить(ИмяСтарыхДвиженийПрихода(), СтарыеДвижения_Приход);

		ДанныеРегистров.Добавить(Данные);
	КонецЦикла;

	Объект.ДополнительныеСвойства.Вставить(ИмяДанныхРегистров(), ДанныеРегистров);

КонецПроцедуры

// Проверяет, что регистр из определяемого типа РегистрыПодКонтролем действительно
// может контролироваться: это должен быть регистр накопления остатков хотя бы
// с одним измерением. Иначе вызывает исключение с описанием причины.
//
// Параметры:
//  МетаданныеРегистра - ОбъектМетаданных - Метаданные регистра накопления.
Процедура ПроверитьВозможностьКонтроляРегистра(МетаданныеРегистра)

	Если МетаданныеРегистра.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
		ВызватьИсключение СтрШаблон(НСтр(
			"ru = 'Система контроля остатков: регистр %1 не может контролироваться - это не регистр остатков.';
			|en = 'Balance control system: register %1 cannot be controlled - it is not a balance register.'"),
			МетаданныеРегистра.ПолноеИмя());
	КонецЕсли;

	Если МетаданныеРегистра.Измерения.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр(
			"ru = 'Система контроля остатков: регистр %1 не может контролироваться - у него нет измерений.';
			|en = 'Balance control system: register %1 cannot be controlled - it has no dimensions.'"),
			МетаданныеРегистра.ПолноеИмя());
	КонецЕсли;

КонецПроцедуры

// Чистит список ресурсов после переопределяемого метода: имена, которых у регистра нет,
// отбрасываются, пустой список - ошибка конфигурирования: выключение регистра делается
// через определяемый тип, а не через пустой список ресурсов.
//
// Параметры:
//  МетаданныеРегистра - ОбъектМетаданных - Метаданные регистра накопления.
//  Ресурсы - Массив из Строка - Имена контролируемых ресурсов после переопределяемого метода.
//                               Недопустимые имена удаляются из массива.
Процедура ПроверитьКонтролируемыеРесурсы(МетаданныеРегистра, Ресурсы)

	ДопустимыеРесурсы = Новый Массив;
	Для Каждого ИмяРесурса Из Ресурсы Цикл
		Если МетаданныеРегистра.Ресурсы.Найти(ИмяРесурса) <> Неопределено Тогда
			ДопустимыеРесурсы.Добавить(ИмяРесурса);
		КонецЕсли;
	КонецЦикла;

	Если ДопустимыеРесурсы.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр(
			"ru = 'Система контроля остатков: у регистра %1 после переопределения не осталось контролируемых ресурсов.';
			|en = 'Balance control system: register %1 has no controlled resources left after overriding.'"),
			МетаданныеРегистра.ПолноеИмя());
	КонецЕсли;

	Ресурсы = ДопустимыеРесурсы;

КонецПроцедуры

// Читает движения документа по одному регистру и виду движения из базы.
// Выбираются только нужные контролю колонки: вид движения, измерения и ресурсы.
// Читаются только активные движения - неактивные не влияют на итоги остатков.
// Псевдоним RecordType обязан совпадать с именем колонки выгрузки набора записей.
//
// Параметры:
//  Ссылка - ДокументСсылка - Ссылка на регистратор.
//  ДанныеРегистра - Структура - Данные регистра со свойствами ПолноеИмя, Измерения и Ресурсы.
//  ВидДвижения - ВидДвиженияНакопления, Неопределено - Отбор по виду движения; Неопределено = оба вида.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Движения документа: колонки RecordType, измерения и ресурсы.
Функция ДвиженияДокумента(Ссылка, ДанныеРегистра, ВидДвижения = Неопределено)

	Если ВидДвижения = Неопределено Тогда
		ВидДвижения = Новый Массив;
		ВидДвижения.Добавить(ВидДвиженияНакопления.Приход);
		ВидДвижения.Добавить(ВидДвиженияНакопления.Расход);
	КонецЕсли;

	ВыбираемыеПоля = Новый Массив;
	ВыбираемыеПоля.Добавить("ВидДвижения");
	_ДополнитьМассив(ВыбираемыеПоля, ДанныеРегистра.Измерения);
	_ДополнитьМассив(ВыбираемыеПоля, ДанныеРегистра.Ресурсы);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ВыбираемыеПоля
	|ИЗ
	|	&ПолноеИмяРегистра КАК ДвиженияРегистра
	|ГДЕ
	|	ДвиженияРегистра.Регистратор = &Регистратор
	|	И ДвиженияРегистра.Активность
	|	И ДвиженияРегистра.ВидДвижения В (&ВидДвижения)";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыбираемыеПоля", ПоляСПсевдонимами(ВыбираемыеПоля, "ДвиженияРегистра"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолноеИмяРегистра", ДанныеРегистра.ПолноеИмя);

	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвижения);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Определяет детали режима записи документа на основании его текущего состояния и заданного режима записи.
//
// Параметры:
//  Объект - ДокументОбъект - Обрабатываемый объект документа.
//  РежимЗаписи - РежимЗаписиДокумента - Применяемый режим записи.
//
// Возвращаемое значение:
//  Структура - Структура с флагами ЭтоОтменаПроведения, ЭтоПерепроведение и ЭтоПроведение.
Функция ДеталиРежимаЗаписи(Объект, РежимЗаписи)

	ДанныеДеталейРежимаЗаписи = Новый Структура("ЭтоОтменаПроведения, ЭтоПерепроведение, ЭтоПроведение", РежимЗаписи
		= РежимЗаписиДокумента.ОтменаПроведения, Ложь, Ложь);

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ДанныеДеталейРежимаЗаписи.ЭтоПерепроведение = Объект.Проведен;
		ДанныеДеталейРежимаЗаписи.ЭтоПроведение = Не Объект.Проведен;
	КонецЕсли;

	Возврат ДанныеДеталейРежимаЗаписи;

КонецФункции

#КонецОбласти

#Область Ядро

// Записывает наборы движений контролируемых регистров, чтобы к моменту чтения остатков движения
// уже были в базе для сравнения.
//
// Параметры:
//  ОбъектДокумента - ДокументОбъект - Записываемый документ.
Процедура ЗаписатьКонтролируемыеНаборыДвижений(ОбъектДокумента)

	Для Каждого ДанныеРегистра Из ОбъектДокумента.ДополнительныеСвойства[ИмяДанныхРегистров()] Цикл
		НаборЗаписей = ОбъектДокумента.Движения[ДанныеРегистра.Имя];
		НаборЗаписей.БлокироватьДляИзменения = Истина;
		НаборЗаписей.Записать();
	КонецЦикла;

КонецПроцедуры

// Выполняет контроль остатков для указанного объекта: проверяет движения расхода и прихода
// по каждому контролируемому регистру и обрабатывает возникающие ошибки.
//
// Параметры:
//  Объект - ДокументОбъект - Обрабатываемый документ.
Процедура ВыполнитьКонтрольОстатков(Объект)

	ОбщиеОшибки = Новый Массив;
	НоваяДата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	ДанныеДеталейРежимаЗаписи = Объект.ДополнительныеСвойства[ИмяДеталейРежимаЗаписи()];
	СтараяДата = Объект.ДополнительныеСвойства[ИмяСтаройДаты()];

	Для Каждого ДанныеРегистра Из Объект.ДополнительныеСвойства[ИмяДанныхРегистров()] Цикл

		НовыеДвижения = Объект.Движения[ДанныеРегистра.Имя].Выгрузить();
		НовыеДвижения_Расход = НовыеДвижения.Скопировать(Новый Структура("ВидДвижения", ВидДвиженияНакопления.Расход));
		НовыеДвижения_Приход = НовыеДвижения.Скопировать(Новый Структура("ВидДвижения", ВидДвиженияНакопления.Приход));

		ОбработатьСторноВДвухТаблицах(НовыеДвижения_Расход, НовыеДвижения_Приход, ДанныеРегистра.Ресурсы);

		ОшибкиРасхода = ПроверитьОстаткиПоРасходу(ДанныеРегистра, НовыеДвижения_Расход, ДанныеДеталейРежимаЗаписи, СтараяДата, НоваяДата);
		ОшибкиПрихода = ПроверитьОстаткиПоПриходу(ДанныеРегистра, НовыеДвижения_Приход, ДанныеДеталейРежимаЗаписи, СтараяДата, НоваяДата);

		_ДополнитьМассив(ОбщиеОшибки, ОшибкиРасхода);
		_ДополнитьМассив(ОбщиеОшибки, ОшибкиПрихода);

	КонецЦикла;

	ОбработатьОшибки(ОбщиеОшибки, Объект);

КонецПроцедуры

// Проверяет остатки по движениям расхода; набор проверок зависит от режима записи
// и соотношения дат (кейсовый подход).
//
// Параметры:
//  ДанныеРегистра - Структура - Данные регистра: движения и метаданные.
//  НовыеДвижения - ТаблицаЗначений - Новые движения расхода для проверки.
//  ДанныеДеталейРежимаЗаписи - Структура - Детали режима записи (проведение, перепроведение, отмена проведения).
//  СтараяДата - Дата - Дата прошлой версии документа.
//  НоваяДата - Дата - Новая дата документа.
//
// Возвращаемое значение:
//  Массив из Структура - Ошибки проверки по движениям расхода.
Функция ПроверитьОстаткиПоРасходу(ДанныеРегистра, НовыеДвижения, ДанныеДеталейРежимаЗаписи, СтараяДата, НоваяДата)

	МеньшаяДата = ?(НоваяДата >= СтараяДата, СтараяДата, НоваяДата);

	ОшибкиРасхода = Новый Массив;

	Если ДанныеДеталейРежимаЗаписи.ЭтоОтменаПроведения Тогда
		Возврат ОшибкиРасхода;
	КонецЕсли;

	ТаблицаУменьшенияРасхода = ТаблицаУменьшенияОстатка(ДанныеРегистра, ДанныеРегистра[ИмяСтарыхДвиженийРасхода()], НовыеДвижения);
	ТаблицаУникальныхКлючейРасхода = ТаблицаУникальныхКлючей(ДанныеРегистра, НовыеДвижения, ДанныеРегистра[ИмяСтарыхДвиженийРасхода()]);

	Если ТаблицаУменьшенияРасхода.Количество() > 0 И ДанныеДеталейРежимаЗаписи.ЭтоПерепроведение Тогда

		ОшибкиРасхода = ПроверитьДостаточностьОстатков(ДанныеРегистра, ТаблицаУникальныхКлючейРасхода, МеньшаяДата);

	ИначеЕсли ТаблицаУменьшенияРасхода.Количество() = 0 И ДанныеДеталейРежимаЗаписи.ЭтоПерепроведение И (НоваяДата < СтараяДата) Тогда

		ОшибкиРасхода = ПроверитьДостаточностьОстатков(ДанныеРегистра, ТаблицаУникальныхКлючейРасхода, НоваяДата);

	ИначеЕсли ДанныеДеталейРежимаЗаписи.ЭтоПроведение Тогда

		ОшибкиРасхода = ПроверитьДостаточностьОстатков(ДанныеРегистра, ТаблицаУникальныхКлючейРасхода, МеньшаяДата);

	КонецЕсли;

	Возврат ОшибкиРасхода;

КонецФункции

// Проверяет остатки по движениям прихода; набор проверок зависит от режима записи
// и соотношения дат (кейсовый подход).
//
// Параметры:
//  ДанныеРегистра - Структура - Данные регистра: движения и метаданные.
//  НовыеДвижения - ТаблицаЗначений - Новые движения прихода для проверки.
//  ДанныеДеталейРежимаЗаписи - Структура - Детали режима записи (проведение, перепроведение, отмена проведения).
//  СтараяДата - Дата - Дата прошлой версии документа.
//  НоваяДата - Дата - Новая дата документа.
//
// Возвращаемое значение:
//  Массив из Структура - Ошибки проверки по движениям прихода.
Функция ПроверитьОстаткиПоПриходу(ДанныеРегистра, НовыеДвижения, ДанныеДеталейРежимаЗаписи, СтараяДата, НоваяДата)

	МеньшаяДата = ?(НоваяДата >= СтараяДата, СтараяДата, НоваяДата);

	ОшибкиПрихода = Новый Массив;

	ТаблицаУменьшенияПрихода = ТаблицаУменьшенияОстатка(ДанныеРегистра, НовыеДвижения, ДанныеРегистра[ИмяСтарыхДвиженийПрихода()]);
	ТаблицаУникальныхКлючейПрихода = ТаблицаУникальныхКлючей(ДанныеРегистра, НовыеДвижения, ДанныеРегистра[ИмяСтарыхДвиженийПрихода()]);

	Если ДанныеДеталейРежимаЗаписи.ЭтоПроведение Тогда
		Возврат ОшибкиПрихода;
	ИначеЕсли ДанныеДеталейРежимаЗаписи.ЭтоОтменаПроведения Тогда
		ОшибкиПрихода = ПроверитьДостаточностьОстатков(ДанныеРегистра, ТаблицаУникальныхКлючейПрихода, МеньшаяДата);
	Иначе // ЭтоПерепроведение

		Если ТаблицаУменьшенияПрихода.Количество() = 0 И (НоваяДата > СтараяДата) Тогда
			ОшибкиПрихода = ПроверитьДостаточностьОстатков(ДанныеРегистра, ТаблицаУникальныхКлючейПрихода, СтараяДата);

		ИначеЕсли ТаблицаУменьшенияПрихода.Количество() > 0 Тогда
			ОшибкиПрихода = ПроверитьДостаточностьОстатков(ДанныеРегистра, ТаблицаУникальныхКлючейПрихода, МеньшаяДата);
		КонецЕсли;

	КонецЕсли;

	Возврат ОшибкиПрихода;

КонецФункции

#КонецОбласти

#Область ОбработкаТаблиц

#Область СторнирующиеДвижения

// Обрабатывает сторнирующие движения у обеих таблиц, используя ресурсы.
//
// Параметры:
//  ТаблицаИсточник - ТаблицаЗначений - Первая обрабатываемая таблица.
//  ТаблицаПриемник - ТаблицаЗначений - Вторая обрабатываемая таблица.
//  Ресурсы - Массив из Строка - Ресурсы, участвующие в сторнировании.
Процедура ОбработатьСторноВДвухТаблицах(ТаблицаИсточник, ТаблицаПриемник, Ресурсы)

	ПеренестиСторнирующиеДвижения(ТаблицаИсточник, ТаблицаПриемник, Ресурсы);
	ПеренестиСторнирующиеДвижения(ТаблицаПриемник, ТаблицаИсточник, Ресурсы);

КонецПроцедуры

// Обрабатывает сторнирующие движения, создавая противоположные движения с другим видом движения.
//
// Параметры:
//  ТаблицаИсточник - ТаблицаЗначений - Таблица с исходными записями.
//  ТаблицаПриемник - ТаблицаЗначений - Таблица, в которую добавляются сторно-записи.
//  Ресурсы - Массив из Строка - Ресурсы, проверяемые на отрицательные значения.
Процедура ПеренестиСторнирующиеДвижения(ТаблицаИсточник, ТаблицаПриемник, Ресурсы)

	СтрокиКУдалению = Новый Массив;

	Для Каждого СтрокаИсточника Из ТаблицаИсточник Цикл
		ЭтоСторно = Ложь;
		УдалятьОчищеннуюСтроку = Истина;
		СтруктураЗаполненияСторноСтроки = Новый Структура;

		Для Каждого Ресурс Из Ресурсы Цикл

			Если СтрокаИсточника[Ресурс] = Неопределено Тогда
				СтрокаИсточника[Ресурс] = 0;
				Продолжить;
			ИначеЕсли СтрокаИсточника[Ресурс] < 0 Тогда
				ЭтоСторно = Истина;
				СтруктураЗаполненияСторноСтроки.Вставить(Ресурс, -СтрокаИсточника[Ресурс]);
				СтрокаИсточника[Ресурс] = 0;
			Иначе
				УдалятьОчищеннуюСтроку = Ложь;
			КонецЕсли;

		КонецЦикла;

		Если ЭтоСторно Тогда
			СторноСтрока = ТаблицаПриемник.Добавить();

			ЗаполнитьЗначенияСвойств(СторноСтрока, СтрокаИсточника, , СтрСоединить(Ресурсы, ", "));
			ЗаполнитьЗначенияСвойств(СторноСтрока, СтруктураЗаполненияСторноСтроки);

			СторноСтрока["ВидДвижения"] = ?(СторноСтрока["ВидДвижения"] = ВидДвиженияНакопления.Расход,
				ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);

			Если УдалятьОчищеннуюСтроку Тогда
				СтрокиКУдалению.Добавить(СтрокаИсточника);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Для Каждого Строка Из СтрокиКУдалению Цикл
		ТаблицаИсточник.Удалить(Строка);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// Обрабатывает и фильтрует движения, выявляя позиции, по которым остаток уменьшается.
//
// Параметры:
//  ДанныеРегистра - Структура - Метаданные регистра: ресурсы и измерения.
//  НовыеДвижения - ТаблицаЗначений - Новые движения; значения их ресурсов меняются на противоположные.
//  СтарыеДвижения - ТаблицаЗначений - Старые движения; таблица изменяется и фильтруется.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Строки, по которым остаток уменьшается.
Функция ТаблицаУменьшенияОстатка(ДанныеРегистра, НовыеДвижения, СтарыеДвижения)

	Для Каждого Строка Из НовыеДвижения Цикл

		Для Каждого Ресурс Из ДанныеРегистра.Ресурсы Цикл

			Если ТипЗнч(Строка[Ресурс]) = Тип("Число") Тогда
				Строка[Ресурс] = -Строка[Ресурс];
			КонецЕсли;

		КонецЦикла;

		НоваяСтрока = СтарыеДвижения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);

	КонецЦикла;

	СтарыеДвижения.Свернуть(СтрСоединить(ДанныеРегистра.Измерения, ","), СтрСоединить(ДанныеРегистра.Ресурсы, ","));

	СтрокиКУдалению = Новый Массив;

	Для Каждого Строка Из СтарыеДвижения Цикл
		ОстатокУменьшился = Ложь;

		Для Каждого Ресурс Из ДанныеРегистра.Ресурсы Цикл

			Если ТипЗнч(Строка[Ресурс]) = Тип("Число") И Строка[Ресурс] > 0 Тогда
				ОстатокУменьшился = Истина;
			КонецЕсли;

		КонецЦикла;

		Если Не ОстатокУменьшился Тогда
			СтрокиКУдалению.Добавить(Строка);
		КонецЕсли;

	КонецЦикла;

	Для Каждого Строка Из СтрокиКУдалению Цикл
		СтарыеДвижения.Удалить(Строка);
	КонецЦикла;

	Возврат СтарыеДвижения;

КонецФункции

// Группирует движения из новых (НовыеДвижения) и старых (СтарыеДвижения) данных по измерениям
// и ресурсам из данных регистра (ДанныеРегистра).
// Вызывается после ТаблицаУменьшенияОстатка, поэтому обе таблицы приходят уже измененными ею:
// осмысленны только колонки ключей измерений результата.
//
// Параметры:
//  ДанныеРегистра - Структура - Измерения и ресурсы регистра.
//  НовыеДвижения - ТаблицаЗначений - Новые движения.
//  СтарыеДвижения - ТаблицаЗначений - Старые движения.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Свернутое объединение обеих таблиц; осмысленны только колонки ключей измерений.
Функция ТаблицаУникальныхКлючей(ДанныеРегистра, НовыеДвижения, СтарыеДвижения)

	ВсеДвижения = СтарыеДвижения.Скопировать();

	Для Каждого Строка Из НовыеДвижения Цикл

		НоваяСтрока = ВсеДвижения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);

	КонецЦикла;

	ВсеДвижения.Свернуть(СтрСоединить(ДанныеРегистра.Измерения, ","), СтрСоединить(ДанныеРегистра.Ресурсы, ","));

	Возврат ВсеДвижения;

КонецФункции

// Проверяет достаточность остатков и собирает ошибки по точкам нехватки.
// Для каждой пары (ключ измерений, ресурс) сообщается самая ранняя точка минуса.
//
// Параметры:
//  МетаданныеЗаписей - Структура - Метаданные регистра.
//  УникальныеКлючи - ТаблицаЗначений - Уникальные ключи измерений для проверки.
//  НачалоПериода - Дата - Начало периода проверки.
//  КонецПериода - Дата, Неопределено - Конец периода проверки; Неопределено = без границы.
//
// Возвращаемое значение:
//  Массив из Структура - Найденные ошибки.
Функция ПроверитьДостаточностьОстатков(МетаданныеЗаписей, УникальныеКлючи, НачалоПериода, КонецПериода = Неопределено)

	Ошибки = Новый Массив;

	Если УникальныеКлючи.Количество() = 0 Тогда
		Возврат Ошибки;
	КонецЕсли;

	ОтрицательныеОстатки = ТаблицаОтрицательныхОстатков(МетаданныеЗаписей, УникальныеКлючи, НачалоПериода, КонецПериода);

	КолонкиИзмерений = СтрСоединить(МетаданныеЗаписей.Измерения, ",");
	ПоказанныеПары = ОтрицательныеОстатки.СкопироватьКолонки(КолонкиИзмерений);
	ПоказанныеПары.Колонки.Добавить("ИмяРесурса", Новый ОписаниеТипов("Строка"));
	ПоказанныеПары.Индексы.Добавить(КолонкиИзмерений + ",ИмяРесурса");

	Для Каждого СтрокаРезультата Из ОтрицательныеОстатки Цикл

		КлючИзмерений = Новый Структура;
		ОтборПары = Новый Структура;
		Для Каждого Измерение Из МетаданныеЗаписей.Измерения Цикл
			КлючИзмерений.Вставить(Измерение, СтрокаРезультата[Измерение]);
			ОтборПары.Вставить(Измерение, СтрокаРезультата[Измерение]);
		КонецЦикла;
		ОтборПары.Вставить("ИмяРесурса", "");

		Для Каждого Ресурс Из МетаданныеЗаписей.Ресурсы Цикл

			ЗначениеРесурса = ?(ЗначениеЗаполнено(СтрокаРезультата[Ресурс]), СтрокаРезультата[Ресурс], 0);
			Если ЗначениеРесурса >= 0 Тогда
				Продолжить;
			КонецЕсли;

			ОтборПары.ИмяРесурса = Ресурс;
			Если ПоказанныеПары.НайтиСтроки(ОтборПары).Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;

			ПоказаннаяПара = ПоказанныеПары.Добавить();
			ЗаполнитьЗначенияСвойств(ПоказаннаяПара, ОтборПары);

			Ошибка = Новый Структура;
			Ошибка.Вставить("Ресурс", Ресурс);
			Ошибка.Вставить("ДатаТочки", СтрокаРезультата.ДатаТочки);
			Ошибка.Вставить("Значение", СтрокаРезультата[Ресурс]);
			Ошибка.Вставить("ДанныеКлюча", СтруктураВСтроку(КлючИзмерений));
			Ошибки.Добавить(Ошибка);
		КонецЦикла;
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

#КонецОбласти

#Область ЗапросОстатков

// Выполняет пакетный запрос остатков: все уникальные ключи измерений проверяются одним
// запросом к виртуальной таблице ОстаткиИОбороты с периодичностью Секунда.
//
// Параметры:
//  МетаданныеЗаписей - Структура - Измерения, ресурсы и полное имя регистра.
//  ТаблицаКлючей - ТаблицаЗначений - Уникальные ключи измерений (лишние колонки игнорируются).
//  НачалоПериода - Дата - Начало периода.
//  КонецПериода - Дата, Неопределено - Конец периода; Неопределено = окно без правой границы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Точки отрицательных остатков (дата, измерения, конечные остатки ресурсов)
//                    в порядке возрастания периода.
Функция ТаблицаОтрицательныхОстатков(МетаданныеЗаписей, ТаблицаКлючей, НачалоПериода, КонецПериода)

	КолонкиИзмерений = СтрСоединить(МетаданныеЗаписей.Измерения, ",");
	УникальныеКлючи = ТаблицаКлючей.Скопировать( , КолонкиИзмерений);
	УникальныеКлючи.Свернуть(КолонкиИзмерений);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаОтрицательныхОстатков(МетаданныеЗаписей);

	Запрос.УстановитьПараметр("ТаблицаКлючей", УникальныеКлючи);
	Запрос.УстановитьПараметр("ЗначенияПервогоИзмерения", _ВыгрузитьКолонку(УникальныеКлючи, МетаданныеЗаписей.Измерения[0], Истина));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Собирает текст пакетного запроса остатков. Зависит только от метаданных регистра.
// Подстановки [Имя] - макросы текста, конструкции &Имя - параметры запроса.
// Условие по первому измерению в виртуальной таблице сделано из-за особенностей работы оптимизатора СУБД.
//
// Параметры:
//  МетаданныеЗаписей - Структура - Измерения, ресурсы и полное имя регистра.
//
// Возвращаемое значение:
//  Строка - Готовый к выполнению текст запроса.
Функция ТекстЗапросаОтрицательныхОстатков(МетаданныеЗаписей)

	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	[ПоляКлючей]
	|ПОМЕСТИТЬ втКлючи
	|ИЗ
	|	&ТаблицаКлючей КАК ТаблицаКлючей
	|ИНДЕКСИРОВАТЬ ПО
	|	[ПервоеИзмерение]
	|;
	|ВЫБРАТЬ ПЕРВЫЕ [МаксимумТочек]
	|	ОсновнойРегистр.Период КАК ДатаТочки,
	|	[ПоляИзмерений],
	|	[ПоляРесурсов]
	|ИЗ
	|	[ПолноеИмяРегистра].ОстаткиИОбороты(
	|			&НачалоПериода, &КонецПериода, Секунда,, [ПервоеИзмерение] В (&ЗначенияПервогоИзмерения)) КАК ОсновнойРегистр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втКлючи КАК Отбор
	|		ПО [УсловияСоединения]
	|ГДЕ
	|	[УсловиеОтрицательногоОстатка]
	|УПОРЯДОЧИТЬ ПО
	|	ДатаТочки";

	МакросыЗапроса = Новый Структура;
	МакросыЗапроса.Вставить("ПоляКлючей", ПоляСПсевдонимами(МетаданныеЗаписей.Измерения, "ТаблицаКлючей"));
	МакросыЗапроса.Вставить("ПервоеИзмерение", МетаданныеЗаписей.Измерения[0]);
	МакросыЗапроса.Вставить("МаксимумТочек", Формат(МаксимальноеКоличествоТочекМинуса(), "ЧН=0; ЧГ="));
	МакросыЗапроса.Вставить("ПоляИзмерений", ПоляСПсевдонимами(МетаданныеЗаписей.Измерения, "ОсновнойРегистр"));
	МакросыЗапроса.Вставить("ПоляРесурсов", ПоляКонечныхОстатков(МетаданныеЗаписей.Ресурсы));
	МакросыЗапроса.Вставить("ПолноеИмяРегистра", МетаданныеЗаписей.ПолноеИмя);
	МакросыЗапроса.Вставить("УсловияСоединения", УсловияСоединения(МетаданныеЗаписей.Измерения, "ОсновнойРегистр", "Отбор"));
	МакросыЗапроса.Вставить("УсловиеОтрицательногоОстатка", УсловиеОтрицательногоОстатка(МетаданныеЗаписей.Ресурсы));

	Возврат _ВставитьПараметрыВСтроку(ШаблонЗапроса, МакросыЗапроса);

КонецФункции

// Формирует список полей вида "Префикс.Имя КАК Имя".
//
// Параметры:
//  ИменаПолей - Массив из Строка - Имена полей.
//  ПрефиксТаблицы - Строка - Псевдоним таблицы для префикса полей.
//
// Возвращаемое значение:
//  Строка - Список полей через запятую для запроса.
Функция ПоляСПсевдонимами(ИменаПолей, ПрефиксТаблицы)

	Разделитель = ", ";
	СтрокиДляЗапроса = Новый Массив;

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		СтрокиДляЗапроса.Добавить(СтрШаблон("%1.%2 КАК %2", ПрефиксТаблицы, ИмяПоля));
	КонецЦикла;

	Возврат СтрСоединить(СтрокиДляЗапроса, Разделитель);

КонецФункции

// Формирует строку полей конечных остатков для запроса.
//
// Параметры:
//  Ресурсы - Массив из Строка - Имена ресурсов для включения в текст запроса.
//
// Возвращаемое значение:
//  Строка - Строка полей конечных остатков для запроса.
Функция ПоляКонечныхОстатков(Ресурсы)

	Разделитель = ", ";
	СтрокиДляЗапроса = Новый Массив;

	Для Каждого Ресурс Из Ресурсы Цикл
		СтрокиДляЗапроса.Добавить(СтрШаблон("ОсновнойРегистр.%1КонечныйОстаток КАК %1", Ресурс));
	КонецЦикла;

	Возврат СтрСоединить(СтрокиДляЗапроса, Разделитель);

КонецФункции

// Формирует список условий соединения вида "Левый.Имя = Правый.Имя И ...".
//
// Параметры:
//  ИменаПолей - Массив из Строка - Имена полей.
//  ПрефиксЛевый - Строка - Псевдоним левой таблицы.
//  ПрефиксПравый - Строка - Псевдоним правой таблицы.
//
// Возвращаемое значение:
//  Строка - Условия соединения для запроса.
Функция УсловияСоединения(ИменаПолей, ПрефиксЛевый, ПрефиксПравый)

	Разделитель = Символы.ПС + "			И ";
	СтрокиДляЗапроса = Новый Массив;

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		СтрокиДляЗапроса.Добавить(СтрШаблон("%1.%3 = %2.%3", ПрефиксЛевый, ПрефиксПравый, ИмяПоля));
	КонецЦикла;

	Возврат СтрСоединить(СтрокиДляЗапроса, Разделитель);

КонецФункции

// Формирует условие отбора строки, в которой хотя бы один ресурс ушел в минус.
//
// Параметры:
//  Ресурсы - Массив из Строка - Имена ресурсов, проверяемых на отрицательный конечный остаток.
//
// Возвращаемое значение:
//  Строка - Условие для секции ГДЕ запроса.
Функция УсловиеОтрицательногоОстатка(Ресурсы)

	Разделитель = " ИЛИ ";
	СтрокиДляЗапроса = Новый Массив;

	Для Каждого Ресурс Из Ресурсы Цикл
		СтрокиДляЗапроса.Добавить(СтрШаблон("ОсновнойРегистр.%1КонечныйОстаток < 0", Ресурс));
	КонецЦикла;

	Возврат СтрСоединить(СтрокиДляЗапроса, Разделитель);

КонецФункции

// Переупорядочивает массивы Измерения и Ресурсы данных регистра по месту
// согласно порядку колонок кластерного индекса (запрос ПЕРВЫЕ 0 к основной таблице регистра).
//
// Параметры:
//  МетаданныеЗаписей - Структура - Метаданные регистра накопления с измерениями и ресурсами.
//                                  Массивы Измерения и Ресурсы заменяются по месту.
//@skip-check query-in-loop
Процедура УпорядочитьМетаданныеПоКластерномуИндексу(МетаданныеЗаписей)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	*
	|ИЗ
	|	&РегистрНакопления КАК ОсновнойРегистр";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РегистрНакопления", МетаданныеЗаписей.ПолноеИмя);

	КолонкиЗапроса = Запрос.Выполнить().Колонки;

	УпорядоченныеИзмерения = Новый Массив;
	УпорядоченныеРесурсы = Новый Массив;

	Для Каждого Колонка Из КолонкиЗапроса Цикл

		Если МетаданныеЗаписей.Измерения.Найти(Колонка.Имя) <> Неопределено Тогда
			УпорядоченныеИзмерения.Добавить(Колонка.Имя);
		ИначеЕсли МетаданныеЗаписей.Ресурсы.Найти(Колонка.Имя) <> Неопределено Тогда
			УпорядоченныеРесурсы.Добавить(Колонка.Имя);
		КонецЕсли;

	КонецЦикла;

	МетаданныеЗаписей.Измерения = УпорядоченныеИзмерения;
	МетаданныеЗаписей.Ресурсы = УпорядоченныеРесурсы;

КонецПроцедуры

#КонецОбласти

#Область ОбработкаОшибок

// Обрабатывает собранные ошибки контроля: формирует сообщение об отказе,
// пишет его в журнал регистрации и отменяет проведение.
//
// Параметры:
//  Ошибки - Массив из Структура - Точки отрицательных остатков, найденные контролем.
//  Объект - ДокументОбъект - Проводимый документ.
Процедура ОбработатьОшибки(Ошибки, Объект)

	КоличествоОшибок = Ошибки.Количество();

	Если КоличествоОшибок > 0 Тогда

		ИтоговоеСообщение = "";
		СтандартнаяОбработка = Истина;
		БиблиотекаКонтроляОстатковПереопределяемый.ПриФормированииТекстаОтказа(Ошибки, Объект, ИтоговоеСообщение,
			СтандартнаяОбработка);

		Если СтандартнаяОбработка Тогда

			ВсеСообщенияОбОшибках = Новый Массив;
			ОсновноеСообщениеОбОшибке = СтрШаблон(НСтр(
				"ru = 'Система контроля отрицательных остатков. Ошибка при работе с %1:';
				|en = 'Balance control system. Error when work with %1:'"), Объект);
			ВсеСообщенияОбОшибках.Добавить(ОсновноеСообщениеОбОшибке);

			Счетчик = 1;
			МноготочиеУжеВыведено = Ложь;

			Для Каждого Ошибка Из Ошибки Цикл

				Если СообщениеПоказывается(Счетчик, КоличествоОшибок) Тогда

					ТекстОшибки = СтрШаблон(НСтр("ru = '%1) При работе с ресурсом %2, получается отрицательный остаток %3 на дату %4.
												 |Данные строки: [%5].';
												 |en = '%1) When working with resource %2, the negative balance is %3 on date %4.
												 |String data: [%5].'"), Счетчик, Ошибка.Ресурс, Ошибка.Значение, Ошибка.ДатаТочки,
						Ошибка.ДанныеКлюча);
					ВсеСообщенияОбОшибках.Добавить(ТекстОшибки);

				ИначеЕсли Не МноготочиеУжеВыведено Тогда
					ВсеСообщенияОбОшибках.Добавить(РазделительСообщений());
					МноготочиеУжеВыведено = Истина;
				КонецЕсли;

				Счетчик = Счетчик + 1;

			КонецЦикла;

			ИтоговоеСообщение = СтрСоединить(ВсеСообщенияОбОшибках, Символы.ПС);

		КонецЕсли;

		ЗаписатьОтказВЖурналРегистрации(Ошибки, Объект);
		ВызватьОшибкуПроведения(ИтоговоеСообщение);

	КонецЕсли;

КонецПроцедуры

// Определяет формат показа сообщений: показываются первые КоличествоПервыхСообщений() сообщений,
// затем разделитель ".....", затем последние КоличествоПоследнихСообщений() сообщений.
// Если все сообщения умещаются в эти две группы, показываются все без разделителя.
//
// Параметры:
//  Счетчик - Число - Номер текущего сообщения.
//  КоличествоОшибок - Число - Общее число ошибок.
//
// Возвращаемое значение:
//  Булево - Истина, если сообщение с этим номером показывается пользователю.
Функция СообщениеПоказывается(Счетчик, КоличествоОшибок)

	Возврат Счетчик <= КоличествоПервыхСообщений() Или Счетчик > КоличествоОшибок - КоличествоПоследнихСообщений();

КонецФункции

// Генерирует ошибку и откатывает транзакцию проведения документа.
//
// Параметры:
//  Описание - Строка - Текст сообщения об отказе.
Процедура ВызватьОшибкуПроведения(Описание)

	ВызватьИсключение Описание;

КонецПроцедуры

// Отказ отменяет проведение, поэтому такие события редки и журнал не раздувают.
// Записи журнала переживают откат транзакции - журнал остается единственным следом отказа.
//
// Параметры:
//  Ошибки - Массив из Структура - Точки отрицательных остатков, найденные контролем.
//  Объект - ДокументОбъект - Проводимый документ.
Процедура ЗаписатьОтказВЖурналРегистрации(Ошибки, Объект)

	Логировать = Истина;
	БиблиотекаКонтроляОстатковПереопределяемый.ПриОпределенииНеобходимостиЛогирования(Объект, Логировать);
	Если Не Логировать Тогда
		Возврат;
	КонецЕсли;

	ЧастиКомментария = Новый Массив;
	Для Индекс = 0 По Мин(Ошибки.ВГраница(), КоличествоТочекВЖурнале() - 1) Цикл
		ОшибкаДляЖурнала = Ошибки[Индекс];
		ЧастиКомментария.Добавить(СтрШаблон("%1 = %2 (%3): [%4]",
			ОшибкаДляЖурнала.Ресурс, ОшибкаДляЖурнала.Значение, ОшибкаДляЖурнала.ДатаТочки,
			ОшибкаДляЖурнала.ДанныеКлюча));
	КонецЦикла;

	Если Ошибки.Количество() > КоличествоТочекВЖурнале() Тогда
		ЧастиКомментария.Добавить(СтрШаблон(НСтр("ru = '... и еще точек минуса: %1';
			|en = '... and more negative points: %1'"), Ошибки.Количество() - КоличествоТочекВЖурнале()));
	КонецЕсли;

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка,
		Объект.Метаданные(), Объект.Ссылка, СтрСоединить(ЧастиКомментария, Символы.ПС));

КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеСредства

// Преобразует структуру в строку вида "Ключ1 = Значение1, Ключ2 = Значение2".
//
// Параметры:
//  ИсходнаяСтруктура - Структура - Преобразуемая структура.
//
// Возвращаемое значение:
//  Строка - Строковое представление структуры.

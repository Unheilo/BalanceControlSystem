	Части = Новый Массив;

	Для Каждого Элемент Из ИсходнаяСтруктура Цикл
		Части.Добавить(СтрШаблон("%1 = %2", Элемент.Ключ, Элемент.Значение));
	КонецЦикла;

	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Очищает дополнительные свойства объекта документа от ключей контроля
// (закрывает кейс "отмена проведения, затем обычная запись").
